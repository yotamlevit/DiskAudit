{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskAudit",
  "version": "1.1.0",
  "identifier": "com.yotamlevit.diskaudit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DiskAudit",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Read-only disk usage visualizer",
    "longDescription": "DiskAudit scans a directory and visualizes disk usage as an interactive treemap. 100% read-only.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
